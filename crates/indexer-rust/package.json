{
  "name": "dsh-plugin-codegraph-indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Native tree-sitter extraction engine for dsh-plugin-codegraph",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "artifacts/**/*.node",
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "codegraph-indexer",
    "packageName": "dsh-plugin-codegraph-indexer",
    "targets": [
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --output-dir artifacts",
    "test": "cargo test"
  }
}
